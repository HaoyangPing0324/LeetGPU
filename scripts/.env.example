# Required: local project root, absolute or relative to the scripts directory.
LOCAL_PROJECT_PATH=/path/to/LeetGPU

# Required: remote operating system, either windows or linux.
REMOTE_OS=windows

# Required: remote SSH connection.
REMOTE_HOST=xxx.xxx.xxx.xxx
REMOTE_PORT=22
REMOTE_USER=your_username

# Optional: use a password only when SSH key or agent authentication is unavailable.
REMOTE_PASSWORD=

# Optional: path to a private SSH key. Leave empty for password or SSH agent authentication.
SSH_KEY_PATH=

# Required: parent directory for temporary remote run directories.
# Windows example: C:/path/to/remote/workspace
# Linux example: /path/to/remote/workspace
REMOTE_ROOT=C:/path/to/remote/workspace

# Optional: set to 1 to retain remote files after a run; 0 removes them.
KEEP_REMOTE=0

# Required for CUDA runs: CUDA compiler command available on the remote server.
# Use nvcc.exe on Windows or nvcc on Linux unless a full path is required.
REMOTE_NVCC=nvcc.exe

# Optional for CUDA runs: host compiler path passed to nvcc with -ccbin.
REMOTE_CCBIN=

# Optional for Windows CUDA runs: Visual Studio environment script. Not used on Linux.
REMOTE_VCVARS=

# Required for Triton and CuTe DSL runs: remote Python interpreter command.
# Use python.exe on Windows or python3 on Linux unless a full path is required.
REMOTE_PYTHON=python.exe
